# Optional. Etherscan API key used only as a third, fallback on-chain provider by the CLI, CI and the server-side proxy.
# The web page never contains this key. Leave unset to run fully keyless (public RPC providers only).
ETHERSCAN_API_KEY=
# Optional. GitHub token for the label sync script (raises the API rate limit from 60/h to 5000/h). `gh auth token` works.
GITHUB_TOKEN=
# Optional. Comma-separated regex terms the scrub test must not find in the repo (kept out of the repo on purpose).
SCRUB_TERMS=
