{
  "name": "morpho-vault-policy-check",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of concept: checks a Morpho vault against the BA Labs Morpho Vaults v2 eligibility criteria, twice, from public sources only.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "dev": "vite",
    "check": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:labels": "tsx scripts/sync-labels.ts",
    "gen:docs": "tsx scripts/gen-docs.ts",
    "record:fixtures": "tsx scripts/record-fixtures.ts",
    "read:safes": "tsx scripts/read-safes.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.21.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "vitest": "^3.0.0"
  }
}
